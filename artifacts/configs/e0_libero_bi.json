{
  "include": [],
  "run": {
    "name": "e0_libero_bi",
    "out_root": "runs",
    "results_root": "results",
    "notes": "E0 mainline reproduction arm, LIBERO 4 suites, no embodied pretraining"
  },
  "data": {
    "layout": "bimanual_80",
    "window": {
      "frames": 9,
      "frame_stride": 4,
      "action_steps": 32,
      "train_start_stride": 4,
      "min_valid_actions": 1
    },
    "canvases": {
      "libero_2cam": {
        "height": 384,
        "width": 256,
        "slots": [
          {
            "camera": "head",
            "row": 0,
            "col": 0,
            "height": 256,
            "width": 256
          },
          {
            "camera": "wrist",
            "row": 256,
            "col": 0,
            "height": 128,
            "width": 128
          }
        ],
        "background": 0
      },
      "bimanual_3cam": {
        "height": 384,
        "width": 320,
        "slots": [
          {
            "camera": "head",
            "row": 0,
            "col": 0,
            "height": 256,
            "width": 320
          },
          {
            "camera": "left_wrist",
            "row": 256,
            "col": 0,
            "height": 128,
            "width": 160
          },
          {
            "camera": "right_wrist",
            "row": 256,
            "col": 160,
            "height": 128,
            "width": 160
          }
        ],
        "background": 0
      }
    },
    "sources": [
      {
        "name": "libero",
        "kind": "libero_lerobot",
        "root": "LOCAL_ASSET/libero_effects",
        "binding": "single_arm_pose10",
        "embodiment": "franka_panda",
        "cameras": {
          "head": "image",
          "wrist": "wrist_image"
        },
        "canvas": "libero_2cam",
        "split": "train",
        "normalization": "quantile",
        "stats_path": "LOCAL_ASSET/libero.json",
        "hours_budget": null,
        "weight": null,
        "has_actions": true,
        "consequence_path": "",
        "fps": 10.0,
        "extra": {
          "with_consequence": true,
          "consequence_layout": "libero_39"
        }
      }
    ],
    "mixture_temperature": 1.0,
    "cache_root": "LOCAL_ASSET/cache",
    "use_cache": true,
    "num_workers": 8,
    "prefetch_factor": 4,
    "consequence_slots": 48,
    "holdout_mod": 10,
    "consequence_horizon": 16
  },
  "model": {
    "world": {
      "backbone_path": "LOCAL_ASSET/Wan2.2-TI2V-5B-Diffusers",
      "pretrained": true,
      "self_mask": "clean_prefix_causal",
      "dtype": "bfloat16",
      "tiny": null
    },
    "agent": {
      "width": 1024,
      "layers": 30,
      "ffn_mult": 4,
      "zero_init_heads": true
    },
    "coupling": {
      "visibility": "bidirectional",
      "detach_world_kv": false,
      "layers": null,
      "consequence_visibility": null
    },
    "gradient_checkpointing": true,
    "clean_frames": 1
  },
  "train": {
    "steps": 20000,
    "batch_size": 16,
    "grad_accum": 1,
    "seed": 0,
    "log_every": 50,
    "save_every": 2000,
    "keep_last": 2,
    "milestones": [
      10000,
      20000
    ],
    "ema_decay": null,
    "fsdp": true,
    "compile": false,
    "resume": "auto",
    "init_from": "",
    "freeze_world": false,
    "optim": {
      "lr": 0.0001,
      "lr_agent": null,
      "betas": [
        0.9,
        0.95
      ],
      "weight_decay": 0.01,
      "grad_clip": 1.0,
      "warmup_steps": 1000,
      "schedule": "cosine",
      "min_lr_ratio": 0.01,
      "decay_steps": 0
    },
    "objective": {
      "lambda_world": 1.0,
      "lambda_action": 1.0,
      "lambda_consequence": 1.0,
      "world_shift": 5.0,
      "action_shift": 5.0,
      "weighting": "bell",
      "plane_mode": "independent",
      "p_boundary": 0.0,
      "consequence_level": "independent"
    },
    "wandb_project": "jam",
    "wandb": false
  },
  "infer": {
    "steps": 10,
    "path": "diagonal",
    "seed": 0,
    "execute_steps": null,
    "checkpoint": "",
    "binding": "",
    "ema": true
  }
}
